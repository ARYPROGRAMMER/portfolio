# Optional. Both are search-engine ownership tokens: without them the site
# builds and indexes normally, you just can't claim it in the two consoles.
#
# Copy to .env.local and fill in to enable.

# Search Console → Add property → HTML tag → the `content` value only.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → the `msvalidate.01` content value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
